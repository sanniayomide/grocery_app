rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/orders/{orderId} {
      function signedInAsOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if signedInAsOwner();
      // Prototype only: client-submitted pricing is not verified here.
      // Do NOT deploy to production before trusted backend price/stock validation.
      allow create: if signedInAsOwner()
        && request.resource.data.userId == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'payOnDelivery'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.subtotalCents is int
        && request.resource.data.subtotalCents >= 0
        && request.resource.data.deliveryFeeCents is int
        && request.resource.data.deliveryFeeCents >= 0
        && request.resource.data.totalCents == request.resource.data.subtotalCents + request.resource.data.deliveryFeeCents;
      allow update, delete: if false;
    }
  }
}
