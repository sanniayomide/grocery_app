rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if signedIn();
      // Products must be managed by a trusted administrative service.
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email;
      // Profile changes require a separately reviewed, field-limited policy.
      allow update, delete: if false;

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        // Prototype checkout. The backend must recalculate product prices,
        // stock and delivery costs before accepting production orders.
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'userId','items','address','subtotalCents','deliveryFeeCents',
            'totalCents','createdAt','status','paymentMethod'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.paymentMethod == 'payOnDelivery'
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 100
          && request.resource.data.address is map
          && request.resource.data.createdAt is timestamp
          && request.resource.data.subtotalCents is int
          && request.resource.data.subtotalCents >= 0
          && request.resource.data.deliveryFeeCents is int
          && request.resource.data.deliveryFeeCents >= 0
          && request.resource.data.totalCents ==
              request.resource.data.subtotalCents + request.resource.data.deliveryFeeCents;
        allow update, delete: if false;
      }
    }
  }
}
